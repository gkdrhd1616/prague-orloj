    },
    "My Sky": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 하늘"
          }
        }
      }
    },
    "My Sky redraws the horizon and twilight for your location; the hand then follows the real Sun, so it reads apparent solar time.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 하늘 모드는 지평선과 박명을 내 위치에 맞게 다시 그립니다. 손은 실제 태양을 따라가므로 시태양시를 가리킵니다."
          }
        }
      }
    },
    "My Sky: device location": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 하늘: 기기 위치"
          }
        }
      }
    },
    "My device sky": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 기기 위치의 하늘"
          }
        }
      }
    },
    "N": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북"
          }
        }
      }
    },
    "Near the outer gold circle: around the June solstice. Near the inner: around December.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바깥 금색 원 가까이면 6월 하지 무렵, 안쪽 원 가까이면 12월 동지 무렵입니다."
          }
        }
      }
    },
    "New": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭"
          }
        }
      }
    },
    "Next": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
