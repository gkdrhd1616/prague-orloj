            "state": "translated",
            "value": "다음"
          }
        }
      }
    },
    "Night": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤"
          }
        }
      }
    },
    "Night: no direct sunlight": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤: 직사광선 없음"
          }
        }
      }
    },
    "No astronomical night": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천문학적 밤 없음"
          }
        }
      }
    },
    "No crisp shadows means the face is in shade or it is night.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또렷한 그림자가 없으면 면이 그늘에 있거나 밤입니다."
          }
        }
      }
    },
    "No sunset today": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 일몰 없음"
          }
        }
      }
    },
    "No twilight crossing": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박명 경계 통과 없음"
          }
        }
      }
    },
    "Note the colour behind it: day, twilight or night.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 뒤의 색을 봅니다. 낮, 박명, 밤 중 하나입니다."
          }
        }
      }
    },
    "ORTVS and OCCASVS are Latin for rising and setting, written in the classical V for U.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ORTVS와 OCCASVS는 '떠오름'과 '짐'을 뜻하는 라틴어로, 고전 표기대로 U를 V로 씁니다."
          }
        }
      }
    },
    "Old Czech time": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옛 체코 시간"
          }
        }
      }
    },
    "On the Prague Orloj": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프라하 오를로이에서는"
          }
        }
      }
    },
    "On the clock the curves and numerals are painted on the fixed plate and only apply while the Sun is above the horizon.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 시계에서 곡선과 숫자는 고정판에 칠해져 있고, 태양이 지평선 위에 있을 때만 쓰입니다."
          }
        }
      }
    },
    "On the clock the ring is a separate gilded part standing in front of the plate, so it casts its own shadow.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 시계에서 고리는 판 앞에 떠 있는 별도의 금빛 부품이라 자기 그림자를 드리웁니다."
          }
        }
      }
    },
    "On the clock the sphere is a hollow ball turned by a mechanism inside it as the Moon's hand moves away from the Sun's.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 시계의 구는 속이 빈 공으로, 달의 바늘이 태양의 손에서 멀어질수록 안쪽 장치가 공을 돌립니다."
          }
        }
      }
    },
    "Open controls": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 열기"
          }
