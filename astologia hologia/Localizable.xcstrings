    "Location unavailable. Allow location access or choose a location in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 알 수 없습니다. 위치 접근을 허용하거나 설정에서 위치를 고르세요."
