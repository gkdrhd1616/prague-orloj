          }
        }
      }
    },
    "Prague dial · CET (UTC+1), without daylight saving · idealized reconstruction": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프라하 다이얼 · CET(UTC+1), 서머타임 없음 · 이상화한 재현"
          }
        }
      }
    },
    "Prague's plate is drawn for the city's latitude. In My Sky the app redraws it for your location.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프라하의 판은 그 도시의 위도에 맞춰 그려져 있습니다. 나의 하늘 모드에서는 앱이 내 위치에 맞게 다시 그립니다."
          }
        }
      }
    },
    "Precise": {
      "extractionState": "manual",
      "localizations": {
