    "24 = sunset": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24 = 일몰"
          }
        }
      }
    },
    "A gilded Sun slides along the golden hand and always sits on the zodiac ring, at the sign the Sun is in.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금빛 태양은 금색 손을 따라 미끄러지며, 언제나 황도 고리 위 태양이 있는 별자리에 놓입니다."
          }
        }
      }
    },
    "A half-silver, half-black sphere on its own hand shows where the Moon is in the zodiac and, by how much silver shows, its phase.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따로 달린 바늘 끝의 반은 은색, 반은 검은색인 구가 황도대에서 달의 위치를, 그리고 보이는 은색의 양으로 달의 위상을 보여 줍니다."
          }
        }
      }
    },
    "A painted map of the sky": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘을 그린 지도"
          }
        }
      }
    },
    "A small gold star marks the vernal equinox, the zodiac's zero point. Against the Roman numerals it shows sidereal (star) time.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 금색 별은 황도대의 기준점인 춘분점을 표시합니다. 로마 숫자에 대어 읽으면 항성시(별의 시간)가 됩니다."
          }
        }
      }
    },
    "All": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체"
          }
        }
      }
    },
    "Apparent solar time": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시태양시"
          }
        }
      }
    },
    "Apparent solar time at the selected coordinates; local civil time is shown separately": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 좌표의 시태양시이며, 현지 표준시는 따로 표시합니다"
          }
        }
      }
    },
    "Approximate": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대략"
          }
        }
      }
    },
