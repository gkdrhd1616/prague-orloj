          }
        }
      }
    },
    "Prague Orloj mode shows the clock as it runs in Prague: the hand keeps Central European Time all year and the sky is Prague's.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프라하 오를로이 모드는 프라하에서 실제로 움직이는 시계를 보여 줍니다. 손은 일 년 내내 중앙유럽 표준시를 따르고, 하늘은 프라하의 하늘입니다."
          }
        }
      }
    },
    "Prague Orloj preset": {
      "extractionState": "manual",
      "localizations": {
