      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투영 보조선과 기술 수치를 표시합니다."
          }
        }
      }
    },
    "Read every moving part against it.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직이는 모든 부분을 이 판에 대어 읽습니다."
          }
        }
      }
    },
    "Read how much silver faces you: that is the phase.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은색이 얼마나 보이는지 읽습니다. 그것이 위상입니다."
          }
        }
      }
    },
    "Read its position on the Roman scale as you would the hand: that is local sidereal time.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 읽듯 로마 숫자 눈금 위의 위치를 읽습니다. 그것이 현지 항성시입니다."
          }
        }
      }
    },
    "Read the black number of the band between the curves it sits in.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태양이 들어 있는 두 곡선 사이 칸의 검은 숫자를 읽습니다."
          }
        }
      }
    },
    "Read the numeral: top half of the dial for daytime hours, bottom half for night.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자를 읽습니다. 다이얼 위쪽 절반은 낮 시간, 아래쪽 절반은 밤 시간입니다."
          }
        }
      }
    },
    "Read the zodiac sign beneath it for the Moon's place in the sky.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 아래 별자리로 하늘에서 달의 위치를 읽습니다."
          }
        }
      }
    },
    "Read the zodiac sign beneath the Sun for the season, and the silver-and-black sphere for the Moon's phase.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태양 아래의 별자리로 계절을, 은색과 검은색으로 된 구로 달의 위상을 읽습니다."
          }
        }
      }
    },
    "Read the zodiac sign under it for the season.": {
      "extractionState": "manual",
